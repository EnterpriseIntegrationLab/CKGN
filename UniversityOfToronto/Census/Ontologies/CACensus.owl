     xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#">
    <owl:Ontology rdf:about="http://ontology.eil.utoronto.ca/tove/cacensus#">
        <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/5087/2/City.owl"/>
        <owl:imports rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972"/>
        <ns:license xml:lang="en">http://creativecommons.org/licenses/by/3.0/</ns:license>
        <dc:creator xml:lang="en">Mark Fox, Anderson Wong</dc:creator>
        <dc:description xml:lang="en">An ontology for representing data from the Canadian Census</dc:description>
        <dc:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-09-22T12:00:00</dc:issued>
        <dc:title xml:lang="en">Canadian Census Ontology</dc:title>
    </owl:Ontology>
    


