    <!-- http://ontology.eil.utoronto.ca/tove/cacensus#CensusProfile -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/tove/cacensus#CensusProfile">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#hasCharacteristic"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#hasTime"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2006/time#DateTimeInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Census Profile is a profile that contains all of the published data found in a given census.

A Census Profile has the following properties:
•hasTime: Identifies the year of the census
•hasCharacteristic: Identifies the categories of data found in the Census Profile</rdfs:comment>
    </owl:Class>
    


