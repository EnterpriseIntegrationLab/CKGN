    <!-- http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#hasValue"/>
                <owl:someValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#hasPart"/>
                <owl:allValuesFrom rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#cardinality_of"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ontology.eil.utoronto.ca/ISO21972/iso21972#Population"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#hasLocation"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/City/JurisdictionalArea"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A Characteristic is an indicator used to represent statistical data about a population or geographic location.

A Characteristic has the following properties:
•hasValue: Identifies the corresponding Measure instance that represents the value of the Characteristic
•cardinality_of: Identifies the Population instance that is described by the Characteristic, if applicable
•hasLocation: Identifies the geographic location for the Characteristic
•hasPart: Identifies the subcharacteristics associated with a given Characteristic</rdfs:comment>
    </owl:Class>
    


    <!-- http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic2016 -->

    <owl:Class rdf:about="http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic2016">
        <rdfs:subClassOf rdf:resource="http://ontology.eil.utoronto.ca/tove/cacensus#Characteristic"/>
        <rdfs:comment xml:lang="en">The Characteristic2016 class contains the Characteristics found in the 2016 Canadian census.</rdfs:comment>
    </owl:Class>
    


